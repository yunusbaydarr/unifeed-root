{
  "name": "git-mcp",
  "description": "Izole branch, commit ve PR yonetim arayuzu. 07_git_vcs_auditor tarafindan kullanilir.",
  "transport": "stdio",
  "command": "npx",
  "args": ["-y", "@modelcontextprotocol/server-git", "--repository", "."],
  "permissions": {
    "allow_direct_push_main": false,
    "allow_force_push": false,
    "require_pr_for_merge": true
  },
  "conventions": {
    "branch_pattern": "^(feature|fix|chore)/[a-z0-9-]+$",
    "commit_pattern": "^(feat|fix|refactor|docs|test|chore|perf|security)\\([a-z0-9-]+\\): .+$"
  },
  "scope": ["branch", "commit", "diff", "pr-create", "pr-review"]
}
